# Copy to .env.kalshi (gitignored) or export in the shell.
# Paper/shadow needs NONE of these — public market data is enough.
#
# Demo (fake money, real order plumbing):
# KALSHI_DEMO_KEY_ID=
# KALSHI_DEMO_PRIVATE_KEY_PATH=/path/to/demo.pem
#
# Prod (real money). The agent will NOT send live orders unless you also
# pass --live and there is no state/KILL_SWITCH_KALSHI file.
# KALSHI_PROD_KEY_ID=
# KALSHI_PROD_PRIVATE_KEY_PATH=/path/to/prod.pem
# KALSHI_LIVE=0
